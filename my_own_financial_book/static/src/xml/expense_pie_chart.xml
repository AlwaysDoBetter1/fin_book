<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="my_own_financial_book.ExpensePieChart" owl="1">
        <div class="o_expense_pie_chart" style="padding: 20px;">
            <h3 class="mb-3" style="text-align: center; color: #2c3e50; font-weight: 600;">
                Expenses Distribution by Category
            </h3>
            <div class="chart-container" style="position: relative; height: 400px; width: 100%;">
                <canvas t-ref="pieChart"/>
            </div>
            <div t-if="expensesData.length === 0" class="alert alert-info mt-3">
                No expenses data available
            </div>
        </div>
    </t>
</templates>

