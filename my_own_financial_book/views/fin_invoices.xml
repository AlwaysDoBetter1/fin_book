<odoo>

    <!-- LIST -->
    <record id="view_fin_invoice_list" model="ir.ui.view">
        <field name="name">fin.invoice.list</field>
        <field name="model">fin.invoice</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="date"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_fin_invoice_form" model="ir.ui.view">
        <field name="name">fin.invoice.form</field>
        <field name="model">fin.invoice</field>
        <field name="arch" type="xml">
            <form string="Invoice">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="book_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
