<odoo>
    <!-- Learning Plans Views -->
    <record id="view_learning_plans_pavlo_tree" model="ir.ui.view">
        <field name="name">learning.plans.pavlo.tree</field>
        <field name="model">learning.plans.pavlo</field>
        <field name="arch" type="xml">
            <list string="Plans of Learning">
                <field name="name"/>
                <field name="author"/>
                <field name="comment"/>
                <field name="links"/>
            </list>
        </field>
    </record>

    <record id="view_learning_plans_pavlo_form" model="ir.ui.view">
        <field name="name">learning.plans.pavlo.form</field>
        <field name="model">learning.plans.pavlo</field>
        <field name="arch" type="xml">
            <form string="Learning Plan">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="comment"/>
                        <field name="links"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_todo_tasks_pavlo_tree" model="ir.ui.view">
        <field name="name">todo.tasks.pavlo.tree</field>
        <field name="model">todo.tasks.pavlo</field>
        <field name="arch" type="xml">
            <list string="#ToDo Tasks">
                <field name="name"/>
                <field name="author"/>
                <field name="comment"/>
                <field name="links"/>
            </list>
        </field>
    </record>

    <record id="view_todo_tasks_pavlo_form" model="ir.ui.view">
        <field name="name">todo.tasks.pavlo.form</field>
        <field name="model">todo.tasks.pavlo</field>
        <field name="arch" type="xml">
            <form string="ToDo Task">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="comment"/>
                        <field name="links"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Future Boughts Views -->
    <record id="view_future_boughts_pavlo_tree" model="ir.ui.view">
        <field name="name">future.boughts.pavlo.tree</field>
        <field name="model">future.boughts.pavlo</field>
        <field name="arch" type="xml">
            <list string="Future Purchases">
                <field name="name"/>
                <field name="author"/>
                <field name="comment"/>
                <field name="links"/>
            </list>
        </field>
    </record>

    <record id="view_future_boughts_pavlo_form" model="ir.ui.view">
        <field name="name">future.boughts.pavlo.form</field>
        <field name="model">future.boughts.pavlo</field>
        <field name="arch" type="xml">
            <form string="Future Purchase">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="comment"/>
                        <field name="links"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

