<odoo>
    <!-- Action -->
    <record id="fin_book_pavlo" model="ir.actions.act_window">
        <field name="name">Financial book</field>
        <field name="res_model">fin.book.pavlo</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="read_book_pavlo" model="ir.actions.act_window">
        <field name="name">Reading book</field>
        <field name="res_model">reading.book.pavlo</field>
        <field name="view_mode">kanban,form</field>
    </record>

    <record id="learning_plans_pavlo" model="ir.actions.act_window">
        <field name="name">Plans of learning</field>
        <field name="res_model">learning.plans.pavlo</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="todo_tasks_pavlo" model="ir.actions.act_window">
        <field name="name">#ToDo</field>
        <field name="res_model">todo.tasks.pavlo</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="future_boughts_pavlo" model="ir.actions.act_window">
        <field name="name">Future Boughts</field>
        <field name="res_model">future.boughts.pavlo</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="english_dictionary" model="ir.actions.act_window">
        <field name="name">English Dictionary</field>
        <field name="res_model">english.dictionary</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>