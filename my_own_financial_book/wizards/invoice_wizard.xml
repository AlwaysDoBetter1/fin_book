<odoo>
    <record id="view_fin_invoice_wizard_form" model="ir.ui.view">
        <field name="name">fin.invoice.wizard.pavlo.form</field>
        <field name="model">fin.invoice.wizard.pavlo</field>
        <field name="arch" type="xml">
            <form string="Add invoice" dialog="true">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="amount"/>
                    </group>
                </sheet>

                <footer>
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
